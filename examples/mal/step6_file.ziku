-- Step 6: Files, Mutation, and Evil

-- ============================================
-- Box primitives (Scheme native)
-- ============================================

let makeBox : MalVal -> MalVal = @("scheme", "box", 1) in
let unbox : MalVal -> MalVal = @("scheme", "unbox", 1) in
let setBoxBang : MalVal -> MalVal -> MalVal = @("scheme", "set-box!", 2) in

-- Global ref to REPL environment (for eval)
let replEnvRef = makeBox MNil in

-- ============================================
-- Helpers
-- ============================================

let rec debugStr = \val =>
  match val {
  | MClosure(p, b, e) => "Closure"
  | MNative(n) => "Native: " ++ n
  | MErr(msg) => "ErrorVal: " ++ msg
  | Pair(v, _) => debugStr v
  | Cons(h, t) => "(" ++ debugStr h ++ " " ++ debugStr t ++ ")"
  | _ => pr_str val
  }
in

let rec evalBindings = \ev bindings env =>
  match bindings {
  | MNil => Pair(MNil, env)
  | Cons(MSym(name), Cons(value, rest)) =>
    let res = label k { ev ev env value ~k } in
    match res {
    | Pair(val, env2) =>
      let newEnv = envSet env2 name val in
      evalBindings ev rest newEnv
    }
  | _ => Pair(MNil, env)
  }
in

let rec evalList = \ev args env =>
  match args {
  | MNil => Pair(MNil, env)
  | Cons(h, t) =>
    let res = label k { ev ev env h ~k } in
    match res {
    | Pair(val, env2) =>
      match evalList ev t env2 {
      | Pair(vals, env3) => Pair(Cons(val, vals), env3)
      }
    }
  | _ => Pair(MNil, env)
  }
in

-- ============================================
-- Atom native functions
-- ============================================

let applyAtomNative = \op args =>
  if strEq op "atom" then
    match args { | Cons(val, MNil) => MAtom(makeBox val) | _ => MErr("atom err") }
  else if strEq op "atom?" then
    match args { | Cons(MAtom(_), MNil) => MTrue | _ => MFalse }
  else if strEq op "deref" then
    match args { | Cons(MAtom(box), MNil) => unbox box | _ => MErr("deref err") }
  else if strEq op "reset!" then
    match args {
    | Cons(MAtom(box), Cons(newVal, MNil)) =>
      let ignored0 = setBoxBang box newVal in newVal
    | _ => MErr("reset! err")
    }
  else MNil
in

-- ============================================
-- Apply
-- ============================================

let apply = \ev func args env ~k =>
  match func {
  | MNative(name) =>
    -- Handle eval specially (needs access to replEnvRef)
    if strEq name "eval" then
      match args {
      | Cons(ast, MNil) =>
        let globalEnv = unbox replEnvRef in
        ev ev globalEnv ast ~k
      | _ => goto(Pair(MErr("eval requires 1 arg"), env), k)
      }
    -- Handle swap! specially (needs to call apply)
    else if strEq name "swap!" then
      match args {
      | Cons(MAtom(box), Cons(func, extraArgs)) =>
        let currentVal = unbox box in
        let allArgs = Cons(currentVal, extraArgs) in
        -- Apply function with CPS
        let applyRes = label swapK {
          apply ev func allArgs env ~swapK
        } in
        match applyRes {
        | Pair(newVal, env2) =>
          let ignored1 = setBoxBang box newVal in
          goto(Pair(newVal, env2), k)
        }
      | _ => goto(Pair(MErr("swap! err"), env), k)
      }
    else
      let atomResult = applyAtomNative name args in
      match atomResult {
      | MNil =>
        -- Not an atom operation, try regular native
        goto(Pair(applyNative name args, env), k)
      | result => goto(Pair(result, env), k)
      }
  | MClosure(params, body, closedEnv) =>
    let newEnvFrame = Cons(MNil, closedEnv) in
    let appliedEnv = bindParams params args newEnvFrame in
    ev ev appliedEnv body ~k
  | _ => goto(Pair(MErr("not a function: " ++ debugStr func), env), k)
  }
in

-- ============================================
-- Eval (CPS)
-- ============================================

let rec eval = \ev env ast ~k =>
  match ast {
  -- Atoms
  | MNum(n) => goto(Pair(MNum(n), env), k)
  | MStr(s) => goto(Pair(MStr(s), env), k)
  | MNil => goto(Pair(MNil, env), k)
  | MTrue => goto(Pair(MTrue, env), k)
  | MFalse => goto(Pair(MFalse, env), k)
  | MErr(msg) => goto(Pair(MErr(msg), env), k)
  | MNative(n) => goto(Pair(MNative(n), env), k)
  | MClosure(p,b,e) => goto(Pair(MClosure(p,b,e), env), k)
  | MAtom(b) => goto(Pair(MAtom(b), env), k)

  -- Symbol lookup
  | MSym(s) => goto(Pair(envGet env s, env), k)

  -- Lists
  | Cons(head, args) =>
    match head {
    | MSym("def!") =>
      match args {
      | Cons(MSym(name), Cons(value, MNil)) =>
        let res = label vk { ev ev env value ~vk } in
        match res {
        | Pair(val, env2) =>
          let newEnv = envSet env2 name val in
          goto(Pair(val, newEnv), k)
        }
      | _ => goto(Pair(MErr("def! requires symbol and value"), env), k)
      }
    | MSym("let*") =>
      match args {
      | Cons(bindings, Cons(body, MNil)) =>
        let newEnvFrame = Cons(MNil, env) in
        match evalBindings ev bindings newEnvFrame {
        | Pair(_, localEnv) =>
           -- Tail call body
           ev ev localEnv body ~k
        }
      | _ => goto(Pair(MErr("let* requires bindings and body"), env), k)
      }
    | MSym("do") =>
      match evalList ev args env {
      | Pair(evaledList, env2) =>
        let rec last = \l =>
          match l {
          | Cons(h, MNil) => h
          | Cons(h, t) => last t
          | _ => MNil
          }
        in
        goto(Pair(last evaledList, env2), k)
      }
    | MSym("if") =>
      match args {
      | Cons(test_, Cons(then_, Cons(else_, MNil))) =>
        let res = label ck { ev ev env test_ ~ck } in
        match res {
        | Pair(testVal, env2) =>
          match testVal {
          | MNil => ev ev env2 else_ ~k
          | MFalse => ev ev env2 else_ ~k
          | _ => ev ev env2 then_ ~k
          }
        }
      | Cons(test_, Cons(then_, MNil)) =>
        let res = label ck { ev ev env test_ ~ck } in
        match res {
        | Pair(testVal, env2) =>
          match testVal {
          | MNil => goto(Pair(MNil, env2), k)
          | MFalse => goto(Pair(MNil, env2), k)
          | _ => ev ev env2 then_ ~k
          }
        }
      | _ => goto(Pair(MErr("if requires test"), env), k)
      }
    | MSym("fn*") =>
      match args {
      | Cons(params, Cons(body, MNil)) =>
        goto(Pair(MClosure(params, body, env), env), k)
      | _ => goto(Pair(MErr("fn* requires params and body"), env), k)
      }

    -- Application
    | _ =>
      let res = label ok { ev ev env head ~ok } in
      match res {
      | Pair(func, env2) =>
        match evalList ev args env2 {
        | Pair(evaledArgs, env3) =>
          apply ev func evaledArgs env3 ~k
        }
      }
    }
  | _ => goto(Pair(MErr("cannot eval"), env), k)
  }
in

-- ============================================
-- REPL
-- ============================================

let replEnv =
  let e0 = emptyEnv in
  let e1 = envSet e0 "+" (MNative("+")) in
  let e2 = envSet e1 "-" (MNative("-")) in
  let e3 = envSet e2 "*" (MNative("*")) in
  let e4 = envSet e3 "/" (MNative("/")) in
  let e5 = envSet e4 "mod" (MNative("mod")) in
  let e6 = envSet e5 "list" (MNative("list")) in
  let e7 = envSet e6 "empty?" (MNative("empty?")) in
  let e8 = envSet e7 "first" (MNative("first")) in
  let e9 = envSet e8 "rest" (MNative("rest")) in
  let e10 = envSet e9 "=" (MNative("=")) in
  let e11 = envSet e10 "<" (MNative("<")) in
  let e12 = envSet e11 ">" (MNative(">")) in
  let e13 = envSet e12 "<=" (MNative("<=")) in
  let e14 = envSet e13 ">=" (MNative(">=")) in
  let e15 = envSet e14 "count" (MNative("count")) in
  let e16 = envSet e15 "list?" (MNative("list?")) in
  let e17 = envSet e16 "cons" (MNative("cons")) in
  let e18 = envSet e17 "concat" (MNative("concat")) in
  let e19 = envSet e18 "nth" (MNative("nth")) in
  let e20 = envSet e19 "read-string" (MNative("read-string")) in
  let e21 = envSet e20 "pr-str" (MNative("pr-str")) in
  let e22 = envSet e21 "println" (MNative("println")) in
  let e23 = envSet e22 "prn" (MNative("prn")) in
  let e24 = envSet e23 "slurp" (MNative("slurp")) in
  let e25 = envSet e24 "str" (MNative("str")) in
  let e26 = envSet e25 "atom" (MNative("atom")) in
  let e27 = envSet e26 "atom?" (MNative("atom?")) in
  let e28 = envSet e27 "deref" (MNative("deref")) in
  let e29 = envSet e28 "reset!" (MNative("reset!")) in
  let e30 = envSet e29 "swap!" (MNative("swap!")) in
  let e31 = envSet e30 "eval" (MNative("eval")) in
  let e32 = envSet e31 "*ARGV*" MNil in
  e32
in

-- Initialize replEnvRef with the actual environment
let ignored2 = setBoxBang replEnvRef replEnv in

-- Define load-file in MAL
let loadFileExpr = "(def! load-file (fn* (f) (eval (read-string (str \"(do \" (slurp f) \"\\nnil)\")))))" in
let initRes = label initK { eval eval replEnv (read_str loadFileExpr) ~initK } in
let replEnvWithLoadFile = match initRes {
| Pair(_, env0) => env0
} in
let ignored3 = setBoxBang replEnvRef replEnvWithLoadFile in

let rec repl_loop = \env =>
  let line = readLine(()) in
  if strLen line == 0 then ()
  else
    let ast = read_str line in
    let res = label k { eval eval env ast ~k } in
    match res {
    | Pair(val, newEnv) =>
      -- Update replEnvRef so eval can access the latest environment
      let ignored3 = setBoxBang replEnvRef newEnv in
      let out = pr_str val in
      let ignored = println(out) in
      repl_loop newEnv
    }
in

repl_loop replEnvWithLoadFile
